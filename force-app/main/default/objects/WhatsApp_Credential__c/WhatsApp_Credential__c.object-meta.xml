<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >Stores Meta WhatsApp Business Platform credentials and account identifiers. Private; restrict access to WhatsApp administrators. Long text fields are required because Custom Settings cannot store more than 255 characters.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <label>WhatsApp Credential</label>
    <nameField>
        <displayFormat>WAC-{00000}</displayFormat>
        <label>Credential Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>WhatsApp Credentials</pluralLabel>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
